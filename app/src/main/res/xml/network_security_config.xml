<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, for every host. No user-installed CAs are trusted. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
