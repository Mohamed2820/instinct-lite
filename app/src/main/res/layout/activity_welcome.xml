<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center" android:padding="32dp" android:layoutDirection="rtl"
    android:background="?android:attr/colorBackground" android:fitsSystemWindows="true">
    <ImageView android:layout_width="112dp" android:layout_height="112dp" android:src="@drawable/ic_launcher_fg"
        android:background="@drawable/welcome_icon_bg" android:clipToOutline="true" android:scaleType="centerCrop"
        android:importantForAccessibility="no"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="@string/welcome_title" android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" android:gravity="center"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/welcome_body" android:gravity="center" android:lineSpacingMultiplier="1.2"
        android:textColor="?attr/colorOnSurfaceVariant"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/welcome_start"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="32dp"
        android:text="@string/welcome_start"/>
</LinearLayout>
